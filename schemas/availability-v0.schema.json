{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/availability-v0.schema.json",
  "title": "OnceMesh Availability Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "peer_id", "generated_at", "entries", "signature"],
  "properties": {
    "spec_version": {"const": "oncemesh.availability/v0"},
    "peer_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_digest", "result_digest", "operation", "artifact_bytes"],
        "properties": {
          "action_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "artifact_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "key_id", "value"],
      "properties": {
        "profile": {"const": "oncemesh.ed25519/v1"},
        "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
