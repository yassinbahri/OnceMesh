{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/federation-pilot-report-v0.schema.json",
  "title": "OnceMesh Federation Pilot Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "run_id", "observed_at", "origin_peer_id", "receiver_peer_id", "origin_url", "action_digest", "advertised_result_digest", "imported_result_digest", "artifacts", "limits", "outcome", "cache", "checks"],
  "properties": {
    "spec_version": {"const": "oncemesh.federation-pilot-report/v0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "origin_peer_id": {"type": "string", "minLength": 1},
    "receiver_peer_id": {"type": "string", "minLength": 1},
    "origin_url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@]+/?$"},
    "action_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "advertised_result_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "imported_result_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest", "size"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_milliseconds", "max_availability_response_bytes", "max_bundle_response_bytes", "max_entries", "max_artifact_bytes", "max_transfer_bytes", "max_availability_age_seconds", "max_future_clock_skew_seconds", "retention_seconds"],
      "properties": {
        "timeout_milliseconds": {"type": "integer", "minimum": 1, "maximum": 60000},
        "max_availability_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "max_bundle_response_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "max_entries": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "max_transfer_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "max_availability_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_future_clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "retention_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit", "reason", "bytes_imported"],
      "properties": {
        "hit": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "bytes_imported": {"type": "integer", "minimum": 0}
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durable", "entries", "blobs", "retain_until"],
      "properties": {
        "durable": {"const": true},
        "entries": {"type": "integer", "minimum": 0},
        "blobs": {"type": "integer", "minimum": 0},
        "retain_until": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls_enabled", "digests_preserved", "local_policy_enforced"],
      "properties": {
        "tls_enabled": {"type": "boolean"},
        "digests_preserved": {"type": "boolean"},
        "local_policy_enforced": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"properties": {"hit": {"const": true}}}}},
      "then": {
        "properties": {
          "advertised_result_digest": {"type": "string"},
          "imported_result_digest": {"type": "string"},
          "artifacts": {"minItems": 1},
          "checks": {"properties": {"digests_preserved": {"const": true}}}
        }
      }
    }
  ]
}
