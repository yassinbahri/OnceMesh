{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/evaluation-v0.schema.json",
  "title": "OnceMesh Evaluation Run v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "name", "allowed_hosts", "repetitions", "request_delay_ms", "urls", "promotion"],
  "properties": {
    "spec_version": {"const": "oncemesh.evaluation/v0"},
    "name": {"type": "string", "minLength": 1},
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "request_delay_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "accept", "freshness_seconds", "estimated_fetch_cost"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "accept": {"type": "string", "minLength": 1},
          "freshness_seconds": {"type": "integer", "minimum": 1},
          "estimated_fetch_cost": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_candidate_hits", "maximum_mismatches", "minimum_candidate_match_rate"],
      "properties": {
        "minimum_candidate_hits": {"type": "integer", "minimum": 1},
        "maximum_mismatches": {"type": "integer", "minimum": 0},
        "minimum_candidate_match_rate": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"}
      }
    }
  }
}
