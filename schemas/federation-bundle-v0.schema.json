{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/federation-bundle-v0.schema.json",
  "title": "OnceMesh Federation Bundle v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "manifest", "receipt", "artifacts"],
  "properties": {
    "spec_version": {"const": "oncemesh.federation-bundle/v0"},
    "manifest": {"type": "object"},
    "receipt": {"type": "object"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
      }
    }
  }
}
