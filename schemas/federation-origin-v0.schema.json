{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/federation-origin-v0.schema.json",
  "title": "OnceMesh Federation Origin Pilot Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "role", "peer_id", "listen", "tls", "availability_private_seed_env", "receipt_public_keys", "authorized_requesters", "publications", "limits"],
  "properties": {
    "spec_version": {"const": "oncemesh.federation-pilot/v0"},
    "role": {"const": "origin"},
    "peer_id": {"type": "string", "minLength": 1},
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_file", "private_key_file"],
      "properties": {
        "certificate_file": {"type": "string", "minLength": 1},
        "private_key_file": {"type": "string", "minLength": 1}
      }
    },
    "availability_private_seed_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "receipt_public_keys": {"$ref": "#/$defs/publicKeys"},
    "authorized_requesters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/peerKey"}
    },
    "publications": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {"file": {"type": "string", "minLength": 1}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_max_age_seconds", "max_future_clock_skew_seconds", "max_remembered_nonces", "max_response_bytes", "max_concurrent_requests", "max_requests_per_window", "rate_window_seconds"],
      "properties": {
        "request_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_future_clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "max_remembered_nonces": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 1000000000},
        "max_concurrent_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_requests_per_window": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "rate_window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  },
  "$defs": {
    "peerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer_id", "public_key_base64url"],
      "properties": {
        "peer_id": {"type": "string", "minLength": 1},
        "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    },
    "publicKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "public_key_base64url"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
        }
      }
    }
  }
}
