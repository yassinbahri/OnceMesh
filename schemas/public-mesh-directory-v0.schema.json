{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/public-mesh-directory-v0.schema.json",
  "title": "OnceMesh Public Mesh Directory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "generated_at", "directory", "meshes"],
  "properties": {
    "spec_version": {"const": "oncemesh.public-mesh-directory/v0"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "policy_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "policy_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "meshes": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/mesh"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version", "peer_id", "purpose", "profile", "key_id", "public_key_base64url"],
      "properties": {
        "spec_version": {"const": "oncemesh.federation-identity/v0"},
        "peer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "purpose": {"enum": ["availability", "receipt"]},
        "profile": {"const": "oncemesh.ed25519/v1"},
        "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "output_schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "output_schema": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "window_started_at", "window_ended_at", "observed_at", "sample_size", "successful_requests", "bytes_served", "availability_ratio", "latency_ms"],
      "properties": {
        "evidence_kind": {"enum": ["operator-reported", "directory-observed"]},
        "window_started_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "window_ended_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "sample_size": {"type": "integer", "minimum": 20},
        "successful_requests": {"type": "integer", "minimum": 0},
        "bytes_served": {"type": "integer", "minimum": 0},
        "availability_ratio": {"type": "string", "pattern": "^(0\\.[0-9]{6}|1\\.000000)$"},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95"],
          "properties": {
            "p50": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "p95": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer_id", "display_name", "description", "operator", "endpoint", "regions", "status", "protocols", "operations", "availability_identity", "receipt_identities", "stats", "submitted_at"],
      "properties": {
        "peer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "website"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "website": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        },
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
        "regions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "status": {"enum": ["listed", "observed", "suspended", "retired"]},
        "protocols": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "operations": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/operation"}},
        "availability_identity": {"$ref": "#/$defs/identity"},
        "receipt_identities": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/identity"}},
        "stats": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stats"}]},
        "submitted_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    }
  }
}
