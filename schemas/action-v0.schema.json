{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/action-v0.schema.json",
  "title": "OnceMesh Action v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "operation", "inputs", "executor", "output_schema", "vary"],
  "properties": {
    "spec_version": {"const": "oncemesh.action/v0"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {"$ref": "#/$defs/map"},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "config"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config": {"$ref": "#/$defs/map"}
      }
    },
    "output_schema": {"type": "string", "minLength": 1},
    "vary": {"$ref": "#/$defs/map"}
  },
  "$defs": {
    "integer": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"$ref": "#/$defs/integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/value"}},
        {"$ref": "#/$defs/map"}
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/value"}
    }
  }
}
