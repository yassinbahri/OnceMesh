{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncemesh.dev/schemas/organization-pilot-v0.schema.json",
  "title": "OnceMesh Organization Pilot v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "pilot_id", "organization_id", "environment_kind", "window", "operations", "owners", "thresholds"],
  "properties": {
    "spec_version": {"const": "oncemesh.organization-pilot/v0"},
    "pilot_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "environment_kind": {"enum": ["real", "synthetic"]},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["starts_on", "ends_on", "minimum_observed_days"],
      "properties": {
        "starts_on": {"type": "string", "format": "date"},
        "ends_on": {"type": "string", "format": "date"},
        "minimum_observed_days": {"type": "integer", "minimum": 1}
      }
    },
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owners": {
      "type": "object", "additionalProperties": false,
      "required": ["workload", "security", "operations"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "security": {"type": "string", "minLength": 1},
        "operations": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_evaluations", "maximum_mismatches", "maximum_error_rate", "minimum_candidate_hit_rate", "minimum_verified_time_saved_ms", "minimum_verified_cost_saved", "maximum_mean_lookup_ms", "minimum_kill_switch_drills"],
      "properties": {
        "minimum_evaluations": {"type": "integer", "minimum": 1},
        "maximum_mismatches": {"type": "integer", "minimum": 0},
        "maximum_error_rate": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
        "minimum_candidate_hit_rate": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
        "minimum_verified_time_saved_ms": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "minimum_verified_cost_saved": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "maximum_mean_lookup_ms": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "minimum_kill_switch_drills": {"type": "integer", "minimum": 0}
      }
    }
  }
}
