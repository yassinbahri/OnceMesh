{
  "spec_version": "oncemesh.federation-pilot/v0",
  "role": "receiver",
  "run_id": "<new-run-id>",
  "receiver_peer_id": "<receiver-peer-id>",
  "request_private_seed_env": "ONCEMESH_REQUEST_SEED",
  "origin": {
    "base_url": "https://<origin-host>:8443",
    "peer_id": "<origin-peer-id>",
    "ca_file": "<trusted-ca-chain.pem>",
    "availability_public_key_base64url": "<origin-availability-public-key>",
    "receipt_public_keys": [
      {"key_id": "<receipt-key-id>", "public_key_base64url": "<receipt-public-key>"}
    ],
    "trusted_producers": ["<approved-origin-producer>"],
    "allowed_operations": ["<operation-name>/<operation-version>"]
  },
  "action_file": "<exact-action.json>",
  "evidence_file": "<new-evidence.json>",
  "cache_directory": "<durable-federation-cache-directory>",
  "limits": {
    "timeout_milliseconds": 5000,
    "max_availability_response_bytes": 1000000,
    "max_bundle_response_bytes": 50000000,
    "max_entries": 1000,
    "max_artifact_bytes": 10000000,
    "max_transfer_bytes": 50000000,
    "max_availability_age_seconds": 300,
    "max_future_clock_skew_seconds": 30,
    "retention_seconds": 86400
  }
}
